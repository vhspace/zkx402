# Wallet that receives x402 payments
RECEIVER_WALLET=0xYourWalletAddress

# CDP API credentials (required for faucet and balance checking)
CDP_API_KEY_ID=organizations/your-org-id/apiKeys/your-key-id
CDP_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----
your-private-key-here
-----END EC PRIVATE KEY-----

# Server port
PORT=3001

# Enable canonical proof policy routing (recommended)
ENABLE_PROOF_POLICY=true

# Enable proof verification cost schedule (optional; used to price vendor API checks + commissions)
ENABLE_PROOF_COSTS=true

# Optional overrides (otherwise server uses proof-policy.json / proof-costs.json next to index.js)
# PROOF_POLICY_PATH=/absolute/or/relative/path/to/proof-policy.json
# PROOF_COSTS_PATH=/absolute/or/relative/path/to/proof-costs.json

# Chain-based Self verification (for local E2E and chain-only mode)
SELF_RPC_URL=http://localhost:8545
BASE_PROOF_OF_HUMAN_RECEIVER=0x0000000000000000000000000000000000000000

# Self.xyz API verifier (optional)
# NOTE: keep secrets in env vars, never in JSON policy/cost files.
SELF_API_URL=https://example.self.xyz/verify
SELF_API_KEY=your_secret_api_key
