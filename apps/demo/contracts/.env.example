# Deployment private key (DO NOT COMMIT REAL KEYS!)
PRIVATE_KEY=0xyour_private_key_here

# Optional: explorer verification API keys (only needed if you pass --verify)
CELOSCAN_API_KEY=
BASESCAN_API_KEY=

# Self Protocol configuration
# NOTE: DeploySender expects `IDENTITY_VERIFICATION_HUB_ADDRESS`
IDENTITY_VERIFICATION_HUB_ADDRESS=0x16ECBA51e18a4a7e61fdC417f0d47AFEeDfbed74
SCOPE_SEED=cdp-agent-verification

# Hyperlane configuration (used by the Foundry deploy scripts)
# NOTE: the deploy scripts read these exact names.
CELO_HYPERLANE_MAILBOX=0xEf9F292fcEBC3848bF4bB92a96a04F9ECBb78E59
CELO_CHAIN_DOMAIN=44787

BASE_HYPERLANE_MAILBOX=0xfFAEF09B3cd11D9b20d1a19bECca54EEC2884766
BASE_CHAIN_DOMAIN=84532

# Deployed contract addresses (filled in after deployment)
BASE_PROOF_OF_HUMAN_RECEIVER=
CELO_PROOF_OF_HUMAN_SENDER=

# Legacy keys (kept for older docs/tools; deploy script will also fill these)
BASE_VERIFICATION_REGISTRY=
CELO_PROOF_OF_HUMAN_BRIDGE=
