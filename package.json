{
  "name": "zkx402-monorepo",
  "version": "1.0.0",
  "description": "zkx402 - x402 protocol extension with zero-knowledge proof verification",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/demo/client",
    "apps/demo/server"
  ],
  "dependencies": {
    "@solana/kit": "^5.1.0",
    "x402": "1.0.1"
  },
  "scripts": {
    "vibe:setup": "node scripts/vibe-setup.mjs",
    "vercel:deploy": "node scripts/vercel-deploy.mjs",
    "vercel:env": "node scripts/vercel-env.mjs",
    "test:tools": "node --test scripts/test/*.test.mjs",
    "dev:server": "npm run dev --workspace=apps/demo/server",
    "dev:client": "npm run dev --workspace=apps/demo/client",
    "dev:replit": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "keywords": ["x402", "zkproof", "payment", "verification"],
  "author": "",
  "license": "ISC"
}
